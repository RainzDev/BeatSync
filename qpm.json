{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "BeatSync",
    "id": "beatsync",
    "version": "0.1.3",
    "url": null,
    "additionalData": {
      "overrideSoName": "libbeatsync.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "python ./extern/includes/mod-scripts/shared/build.py $0:?"
      ],
      "copy": [
        "python ./extern/includes/mod-scripts/shared/cpy.py $0:?"
      ],
      "debug": [
        "python ./extern/includes/mod-scripts/shared/debug.py $0:?"
      ],
      "log": [
        "python ./extern/includes/mod-scripts/shared/log.py $0:?"
      ],
      "profile": [
        "python ./extern/includes/mod-scripts/shared/profile.py $0:?"
      ],
      "restart": [
        "python ./extern/includes/mod-scripts/shared/restart.py $0:?"
      ]
    },
    "ndk": "^28.2.13676358",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs",
      "."
    ],
    "qmodIncludeFiles": [
      "./src/assets/logo.png"
    ],
    "qmodOutput": "./BeatSync.qmod"
  },
  "dependencies": [
    {
      "id": "mod-scripts",
      "versionRange": "^1.0.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "flamingo",
      "versionRange": "^1.2.1",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4503.0.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.5",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "reflectcpp",
      "versionRange": "^0.25.0",
      "additionalData": {}
    },
    {
      "id": "web-utils",
      "versionRange": "^0.6.10",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.3.5",
      "additionalData": {}
    },
    {
      "id": "rapidjson",
      "versionRange": "^0.1.20250205132808",
      "additionalData": {}
    },
    {
      "id": "playlistcore",
      "versionRange": "^1.7.3",
      "additionalData": {}
    }
  ]
}